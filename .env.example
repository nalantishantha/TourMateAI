# TourMateAI — environment variable template.
# Copy to `.env` (never commit `.env`) and fill in real values.
# Backend reads these; frontend uses its own VITE_* vars (see frontend/.env.example if added).

# ===== Flask backend =====
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=change-me

# ===== MySQL database =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tourmateai
DB_USER=tourmateai_user
DB_PASSWORD=tourmate_ai

# ===== Google Gemini (RAG chatbot) =====
GEMINI_API_KEY=

# ===== Google Maps (routing / location) =====
GOOGLE_MAPS_API_KEY=

# ===== OpenWeather (weather context) =====
OPENWEATHER_API_KEY=

# ===== Firebase Authentication =====
# Path to the service account JSON used by firebase-admin on the backend.
FIREBASE_CREDENTIALS=serviceAccountKey.json

# ===== RAG / AI config =====
CHROMA_DB_PATH=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2
